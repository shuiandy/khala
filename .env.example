# Settings for docker compose (copy to .env). Every KHALA_* and SMTP_* setting in the README can go here.

# The domain people and agents use; its DNS must point at this machine
KHALA_DOMAIN=memory.example.com
# Who becomes admin on the first start
KHALA_OWNERS=you@example.com
# Time zone for dates and the times shown on the web
KHALA_TIMEZONE=UTC

# Sign-in codes go out by email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Khala <khala@example.com>
