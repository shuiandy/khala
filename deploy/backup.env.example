# /etc/khala/backup.env (root:khala 640). With this file present, deploy.sh installs the 15-minute record
# backup timer. The SSH key is github-deploy-key in the state directory (/srv/khala/state; a write deploy key
# on that repository), and the pinned host key is github_known_hosts next to it.
BACKUP_REMOTE=git@github.com:your-account/khala-records.git
