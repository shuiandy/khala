# /etc/khala/state-backup.env (root:khala 640). With this file present, deploy.sh installs the
# daily encrypted state snapshot timer. Only the age public key lives on the server; keep the private key
# offline (a password manager), since it decrypts everything the snapshot holds.
STATE_BACKUP_RECIPIENT=age1...
# A private repository that receives state.tar.age; SSH key github-state-key in the state directory
STATE_BACKUP_REMOTE=git@github.com:your-account/khala-state.git
