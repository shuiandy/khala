# Copy to deploy/local.env (gitignored) and fill in. Read by deploy/deploy.sh on the machine you deploy from.

# SSH login on the server; the user needs sudo
DEPLOY_HOST=admin@203.0.113.10
# Private key for that login
DEPLOY_SSH_KEY=$HOME/.ssh/khala-server
# Public URL of the instance (same as KHALA_ISSUER on the server), used for the post-deploy checks
DEPLOY_URL=https://memory.example.com

# Server layout. The defaults below need no change for a new server.
# Code and virtualenv in $DEPLOY_ROOT/app, records in $DEPLOY_ROOT/vault.git, state in $DEPLOY_ROOT/state
#DEPLOY_ROOT=/srv/khala
# server.env (KHALA_* settings), smtp.env (optional), backup.env, state-backup.env and secret.key
#DEPLOY_ETC=/etc/khala
# systemd unit name, and the system user the server runs as
#DEPLOY_SERVICE=khala
#DEPLOY_USER=khala
# Local port behind the reverse proxy
#DEPLOY_PORT=8100
# User that pushes to the repository over SSH, when a mirror does (the hook is dry-run as this user)
#DEPLOY_GIT_USER=
